# ============================================================
# T-Search - Ejemplo de Variables de Entorno (.env.example)
# ============================================================
# Instrucciones para el equipo:
# 1. Copia este archivo y renómbralo a ".env" en la raíz del proyecto:
#      cp .env.example .env
# 2. Reemplaza los valores de ejemplo con las credenciales reales de Supabase.
# 3. IMPORTANTE:
#    - En Windows, "port" y "PORT" son la misma variable; usa DB_PORT para
#      PostgreSQL y PORT=3000 para Express.
#    - Si la contraseña empieza con '#', DEBE ir entre comillas dobles ("...").
#    - En redes IPv4 con Supabase Free, usa el host del Pooler (aws-0-us-east-2.pooler.supabase.com)
#      y el usuario con formato "postgres.<id_del_proyecto>".
# ============================================================

PORT=3000
APP_PORT=3000

DB_PROJECT_REF="tu_id_de_proyecto_supabase"
DB_REGION="us-east-2"
DB_HOST="aws-0-us-east-2.pooler.supabase.com"
DB_PORT=5432
DB_NAME="postgres"
DB_USER="postgres.tu_id_de_proyecto_supabase"
DB_PASSWORD="#TU_CONTRASENA_AQUI"

DATABASE_URL="postgresql://postgres.tu_id_de_proyecto_supabase:TU_CONTRASENA_URL_ENCODED@aws-0-us-east-2.pooler.supabase.com:5432/postgres"