# ============================================================
# T-Search - Ejemplo de Variables de Entorno (.env.example)
# ============================================================
# Instrucciones para el equipo:
# 1. Copia este archivo y renómbralo a ".env" en la raíz del proyecto:
#      cp .env.example .env
# 2. Reemplaza los valores de ejemplo con las credenciales reales de Supabase.
# 3. IMPORTANTE: Si la contraseña empieza con '#' o tiene caracteres especiales,
#    DEBE ir entre comillas dobles ("...") para que dotenv no la tome como comentario.
# ============================================================

host="db.tu-proyecto.supabase.co"
port=5432
database="postgres"
user="postgres"
password="#TU_CONTRASENA_AQUI"

# Variables estándar para el Pool de conexiones en Node.js (database/db.js)
DB_HOST="db.tu-proyecto.supabase.co"
DB_PORT=5432
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="#TU_CONTRASENA_AQUI"

# URL de conexión PostgreSQL (con caracteres especiales de contraseña codificados en URL)
Url="postgresql://postgres:TU_CONTRASENA_URL_ENCODED@db.tu-proyecto.supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres:TU_CONTRASENA_URL_ENCODED@db.tu-proyecto.supabase.co:5432/postgres"

# Puerto del servidor Express
PORT=3000

